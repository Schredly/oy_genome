{
  "domain_model": {
    "entities": [
      {
        "name": "Beach Rental",
        "attributes": [
          {
            "name": "rental_duration",
            "type": "integer",
            "required": true
          },
          {
            "name": "customer_name",
            "type": "string",
            "required": true
          },
          {
            "name": "rental_type",
            "type": "enum",
            "required": true,
            "choices": [
              "Kayak",
              "Jet Ski",
              "Surfboard"
            ]
          }
        ],
        "relationships": [
          {
            "entity": "Customer",
            "type": "belongs_to"
          }
        ]
      }
    ]
  },
  "application_services": [
    {
      "name": "Validate Rental Duration",
      "responsibilities": [
        "Ensure the rental duration is greater than zero.",
        "Verify customer eligibility."
      ],
      "inputs": [
        "rental_duration",
        "customer_name"
      ],
      "outputs": [
        "validation_status"
      ]
    }
  ],
  "workflows": [
    {
      "name": "Beach Rental Approval",
      "steps": [
        {
          "action": "Check customer eligibility",
          "condition": "rental_duration > 0"
        },
        {
          "action": "Approve or reject rental request"
        }
      ]
    }
  ],
  "api_surface": [
    {
      "endpoint": "/api/rentals",
      "method": "POST",
      "purpose": "Submit a new rental request"
    },
    {
      "endpoint": "/api/rentals/eligibility",
      "method": "GET",
      "purpose": "Check customer rental eligibility"
    }
  ],
  "ui_model": {
    "screens": [
      {
        "name": "Beach Rentals List",
        "components": [
          {
            "type": "table",
            "data_source": "Beach Rental",
            "filter": "active=true"
          }
        ]
      },
      {
        "name": "Rental Form",
        "components": [
          {
            "type": "form",
            "fields": [
              {
                "name": "rental_duration",
                "type": "integer",
                "required": true
              },
              {
                "name": "customer_name",
                "type": "string",
                "required": true
              },
              {
                "name": "rental_type",
                "type": "select",
                "choices": [
                  "Kayak",
                  "Jet Ski",
                  "Surfboard"
                ],
                "required": true
              }
            ]
          }
        ]
      }
    ]
  },
  "automation_rules": [
    {
      "name": "decrement_inventory_on_checkout",
      "trigger": "checkout_created",
      "action": "reduce inventory count"
    },
    {
      "name": "increment_inventory_on_return",
      "trigger": "checkout_returned",
      "action": "increase inventory count"
    }
  ]
}