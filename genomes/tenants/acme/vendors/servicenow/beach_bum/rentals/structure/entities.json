[
  {
    "name": "Rental Contract",
    "type": "Contract",
    "table": "u_rental_contract",
    "fields": [
      {
        "name": "contract_id",
        "type": "string",
        "required": true
      },
      {
        "name": "start_date",
        "type": "date",
        "required": true
      },
      {
        "name": "end_date",
        "type": "date",
        "required": true
      },
      {
        "name": "status",
        "type": "choice",
        "required": true,
        "choices": [
          "active",
          "past_due",
          "completed"
        ]
      }
    ],
    "relationships": [
      {
        "target_table": "u_customer",
        "type": "belongs_to",
        "via_field": "customer_id"
      }
    ]
  }
]