{
  "domain_model": {
    "entities": [
      {
        "name": "RentalContract",
        "fields": [
          {
            "name": "contract_id",
            "type": "string",
            "required": true
          },
          {
            "name": "start_date",
            "type": "date",
            "required": true
          },
          {
            "name": "end_date",
            "type": "date",
            "required": true
          },
          {
            "name": "status",
            "type": "enum",
            "values": [
              "active",
              "past_due",
              "completed"
            ],
            "required": true
          }
        ],
        "relationships": [
          {
            "entity": "Customer",
            "type": "belongs_to"
          }
        ]
      }
    ]
  },
  "application_services": [
    {
      "name": "RentalContractService",
      "responsibilities": [
        "Manage rental contracts lifecycle"
      ],
      "inputs": [
        "Rental contract data"
      ],
      "outputs": [
        "Processed rental contract information"
      ]
    }
  ],
  "workflows": [
    {
      "name": "BeachRentalProcess",
      "steps": [
        {
          "name": "Validate Rental Duration",
          "action": "Validate rental duration with status update"
        },
        {
          "name": "Notify User",
          "action": "Notify user upon contract initiation"
        }
      ]
    }
  ],
  "api_surface": [
    {
      "endpoint": "/api/rental_contracts",
      "method": "POST",
      "purpose": "Create a new rental contract"
    },
    {
      "endpoint": "/api/rental_contracts/{id}",
      "method": "PUT",
      "purpose": "Update rental contract status"
    },
    {
      "endpoint": "/api/customers/{id}",
      "method": "GET",
      "purpose": "Retrieve customer information"
    }
  ],
  "ui_model": {
    "screens": [
      {
        "name": "RentalContractsList",
        "components": [
          {
            "type": "list",
            "data_source": "RentalContract",
            "filter": "status=active"
          }
        ]
      },
      {
        "name": "ContractDetails",
        "components": [
          {
            "type": "form",
            "data_source": "RentalContract",
            "filter": "by_id"
          }
        ]
      }
    ]
  },
  "automation_rules": [
    {
      "name": "ValidateContractStatus",
      "trigger": "Before create rental contract",
      "action": "Validate the contract status and update related customer record"
    },
    {
      "name": "UpdateCustomerRecordOnStatusChange",
      "trigger": "On contract status change",
      "action": "Update the linked customer record"
    }
  ]
}