{
  "domain_model": {
    "entities": [
      {
        "name": "Rentals",
        "attributes": [
          "customer_id",
          "rental_date",
          "return_date",
          "item",
          "price",
          "status"
        ],
        "relationships": [
          "customers",
          "items"
        ]
      },
      {
        "name": "Customers",
        "attributes": [
          "name",
          "contact_information",
          "membership_status"
        ],
        "relationships": [
          "rentals"
        ]
      },
      {
        "name": "Items",
        "attributes": [
          "item_name",
          "item_code",
          "category",
          "availability"
        ],
        "relationships": [
          "rentals"
        ]
      }
    ]
  },
  "application_services": [
    {
      "name": "Payment Service",
      "responsibilities": "Process payments for rental transactions",
      "inputs": [
        "rental_id",
        "customer_id",
        "total_price"
      ],
      "outputs": [
        "payment_confirmation"
      ]
    },
    {
      "name": "Customer Sync Service",
      "responsibilities": "Synchronize customer data with central database",
      "inputs": [
        "customer_data"
      ],
      "outputs": [
        "sync_confirmation"
      ]
    }
  ],
  "workflows": [
    {
      "name": "Process Beach Rental",
      "steps": [
        {
          "name": "Verify Customer",
          "action": "Validate membership status from historical data"
        },
        {
          "name": "Check Availability",
          "action": "Ensure item is available for rental"
        },
        {
          "name": "Calculate Rental Cost",
          "action": "Compute price based on item and duration"
        },
        {
          "name": "Notify Customer",
          "action": "Inform customer about rental status"
        }
      ]
    }
  ],
  "api_surface": [
    {
      "endpoint": "/rentals",
      "method": "POST",
      "purpose": "Process a new rental request"
    },
    {
      "endpoint": "/rentals/{rental_id}",
      "method": "PUT",
      "purpose": "Update rental information"
    },
    {
      "endpoint": "/customers",
      "method": "GET",
      "purpose": "Retrieve customer data"
    }
  ],
  "ui_model": {
    "screens": [
      {
        "name": "Rental Management",
        "components": [
          "RentalList",
          "RentalDetail",
          "NewRentalForm"
        ]
      },
      {
        "name": "Customer Management",
        "components": [
          "CustomerList",
          "CustomerDetail",
          "NewCustomerForm"
        ]
      }
    ]
  },
  "automation_rules": [
    {
      "name": "Rental Status Update",
      "trigger": "After rental update",
      "action": "Adjust rental status based on the return date"
    },
    {
      "name": "Customer Verification",
      "trigger": "Before customer entry is recorded",
      "action": "Verify customer using historical data"
    },
    {
      "name": "Reduce Inventory on Checkout",
      "trigger": "Checkout creation",
      "action": "Decrease the item's available stock"
    },
    {
      "name": "Restore Inventory on Return",
      "trigger": "Checkout return",
      "action": "Increase the item's available stock"
    }
  ]
}