  "application_services": [
    {
      "name": "Egg Collection Service",
      "responsibilities": [
        "Record and verify daily egg collections",
        "Generate daily production reports"
      ],
      "inputs": [
        "Egg Log"
      ],
      "outputs": [
        "Production Report"
      ]
    },
    {
      "name": "Flock Management Service",
      "responsibilities": [
        "Maintain flock details",
        "Update head count based on bird status"
      ],
      "inputs": [
        "Bird",
        "Flock"
      ],
      "outputs": [
        "Flock Summary"
      ]
    },
    {
      "name": "Feed Inventory Service",
      "responsibilities": [
        "Manage feed stock levels and reordering"
      ],
      "inputs": [
        "Feed"
      ],
      "outputs": [
        "Reorder Requests"
      ]
    }
  ],
  "workflows": [
    {
      "name": "Egg Collection Analysis",
      "steps": [
        "Record egg collection",
        "Verify egg counts",
        "Report production rate"
      ]
    }
  ],
  "api_surface": [
    {
      "endpoint": "/api/v1/eggs",
      "method": "GET",
      "purpose": "Retrieve data on current egg availability"
    }
  ],
  "ui_model": {
    "screens": [
      {
        "name": "Flock Management",
        "components": [
          {
            "data_list": "Flock"
          }
        ]
      },
      {
        "name": "Breed Catalog",
        "components": [
          {
            "data_list": "Breed"
          }
        ]
      },
      {
        "name": "Egg Log",
        "components": [
          {
            "data_list": "Egg Log"
          },
          {
            "form": "New Collection Entry"
          }
        ]
      }
    ]
  },
  "automation_rules": [
    {
      "name": "Calculate Bird Age",
      "trigger": "Bird record created",
      "action": "Calculate age from hatch date and update if older than 20 weeks"
    },
    {
      "name": "Adjust Flock Head Count",
      "trigger": "Bird status changes",
      "action": "Update flock head count accordingly"
    },
    {
      "name": "Compute Egg Production Rate",
      "trigger": "New egg log entry",
      "action": "Calculate production rate"
    },
    {
      "name": "Auto-Create Feed Reorder",
      "trigger": "Feed amount below threshold",
      "action": "Generate reorder request"
    },
    {
      "name": "Calculate Order Total",
      "trigger": "New order entry",
      "action": "Calculate subtotal and total cost"
    },
    {
      "name": "Award Loyalty Eggs",
      "trigger": "Order fulfillment",
      "action": "Assign loyalty points based on order value"
    },
    {
      "name": "Escalate Critical Incidents",
      "trigger": "Incident marked critical",
      "action": "Increase priority and urgency, notify staff"
    }
  ]
}