  "automation_rules": [
    {
      "name": "CalculateBirdAge",
      "trigger": "Before bird update",
      "action": "Update bird age from hatch date"
    },
    {
      "name": "AdjustFlockHeadCount",
      "trigger": "After bird update",
      "action": "Adjust flock count based on bird activity status"
    },
    {
      "name": "CalculateOrderTotal",
      "trigger": "Before order update",
      "action": "Compute total cost for an order"
    },
    {
      "name": "AwardLoyaltyPoints",
      "trigger": "After order fulfilled",
      "action": "Update loyalty points for customer"
    },
    {
      "name": "EscalateCriticalIncident",
      "trigger": "Before incident update",
      "action": "Increase priority of critical incidents"
    }
  ]
