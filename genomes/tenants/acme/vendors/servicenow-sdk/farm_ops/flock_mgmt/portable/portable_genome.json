      {
        "name": "CSASubscription"
      }
    ]
  },
  "application_services": [
    {
      "name": "BirdManagementService",
      "responsibilities": "Manage bird-related data and operations",
      "inputs": "Bird data payloads",
      "outputs": "Success/Failure response"
    },
    {
      "name": "EggProductionService",
      "responsibilities": "Handle egg production logging and statistics",
      "inputs": "Egg log data payloads",
      "outputs": "Updated production metrics"
    },
    {
      "name": "CustomerOrderService",
      "responsibilities": "Process and manage customer orders",
      "inputs": "Order data payloads",
      "outputs": "Success/Failure response"
    },
    {
      "name": "InventoryManagementService",
      "responsibilities": "Manage inventory levels and reorder processes",
      "inputs": "Feed inventory data payloads",
      "outputs": "Reorder tasks/alerts"
    },
    {
      "name": "SubscriptionManagementService",
      "responsibilities": "Handle CSA subscription management",
      "inputs": "Subscription data payloads",
      "outputs": "Subscription renewal notifications"
    }
  ],
  "workflows": [
    {
      "name": "CSASubscriptionRenewalWorkflow",
      "steps": [
        {
          "trigger": "Subscription status changes to paused"
        },
        {
          "action": "Send reminder email to customer"
        }
      ]
    },
    {
      "name": "LowFeedReorderWorkflow",
      "steps": [
        {
          "trigger": "Feed inventory level below threshold"
        },
        {
          "action": "Send reorder alert and creates incident for low feed"
        }
      ]
    }
  ],
  "api_surface": [
    {
      "endpoint": "/api/v1/eggs/availability",
      "method": "GET",
      "purpose": "Provides egg stock data for external use"
    }
  ],
